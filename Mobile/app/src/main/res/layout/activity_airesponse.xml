<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#303030"
    android:paddingTop="32dp"
    tools:context=".AIResponseActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Sugestão da IA"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewAIResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="Claro, posso ajudar! Para um computador que não liga, vamos tentar o seguinte:\n\n1. Verifique se o cabo de energia está firmemente conectado na tomada e no computador.\n\n2. Tente usar uma tomada diferente que você sabe que está funcionando.\n\n3. Se for um notebook, remova a bateria (se possível), segure o botão de ligar por 15 segundos e tente ligá-lo apenas com o carregador conectado." />
    </ScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNotSolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            android:layout_toStartOf="@id/center_anchor"
            android:backgroundTint="#D9534F"
            android:text="Não Resolveu" />

        <View
            android:id="@+id/center_anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_centerHorizontal="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSolved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_toEndOf="@id/center_anchor"
            android:backgroundTint="#4CAF50"
            android:text="Funcionou!" />

    </RelativeLayout>
</LinearLayout>