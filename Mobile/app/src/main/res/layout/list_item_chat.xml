<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_container_background"
    android:layout_marginBottom="8dp"> <ImageView
    android:id="@+id/imageViewProfile"
    android:layout_width="50dp"
    android:layout_height="50dp"
    android:src="@drawable/ic_profile_generic"
    android:layout_marginEnd="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewProfessionalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Breno Queiroz"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textViewLastMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ticket: Teclado n funciona"
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>