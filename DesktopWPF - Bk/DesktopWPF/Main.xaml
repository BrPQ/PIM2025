<Window x:Class="DesktopWPF.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopWPF"
        xmlns:converters="clr-namespace:DesktopWPF.Converters"
        mc:Ignorable="d"
        Title="Infiniti PRO - Sistema de Suporte" Height="720" Width="1280"
        Icon="/Images/InfiniTI PRO - Icone Desktop.ico"
        WindowStartupLocation="CenterScreen"
        Background="#212121">

    <Window.Resources>
        <converters:FilenameToIconConverter x:Key="FilenameToIconConverter" />
        <Style TargetType="Button" x:Key="MenuButtonTheme">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ContactItemTemplate">
            <Button Click="ContactButton_Click" 
            Style="{StaticResource MenuButtonTheme}" 
            Height="60"
            Background="#4A4A4A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Images/avatar.png" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TicketInfo}" Foreground="Gray" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MessageItemTemplate">
            <Grid x:Name="MessageContainer" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="AuthorAvatar" Grid.Column="0"
                 Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Images/avatar.png" />
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock x:Name="AuthorInfo" FontWeight="Bold" Foreground="White">
                <Run Text="{Binding Author}" /> - <Run Text="{Binding AuthorRole}" Foreground="Gray" FontSize="11" />
                    </TextBlock>
                    <Border x:Name="MessageBubble"
                    Padding="12"
                    Margin="0,5,50,0"
                    Background="#4A4A4A"
                    CornerRadius="10,10,10,0">
                        <TextBlock Text="{Binding Conteudo}" Foreground="White" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSentByMe}" Value="True">
                    <Setter TargetName="MessageContainer" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="MessageBubble" Property="Margin" Value="50,5,0,0" />
                    <Setter TargetName="MessageBubble" Property="Background" Value="#005C4B" />
                    <Setter TargetName="MessageBubble" Property="CornerRadius" Value="10,10,0,10" />
                    <Setter TargetName="AuthorAvatar" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AuthorInfo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="Button" x:Key="TransparentNoHoverButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AnexoReadOnlyItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="10,5,0,5">
                <Image Source="{Binding NomeArquivo, Converter={StaticResource FilenameToIconConverter}}"  
               Width="20" Height="20" Margin="0,0,8,0"/>

                <Button Click="Anexo_Click"
                Content="{Binding NomeArquivo}" 
                Foreground="White" 
                VerticalAlignment="Center"
                Style="{StaticResource TransparentNoHoverButton}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AnexoItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="10,5,0,5">
                <Image Source="{Binding }"
               Width="20" Height="20" Margin="0,0,8,0" />

                <Button Click="Anexo_Click"
                Content="{Binding}"
                Foreground="White"
                VerticalAlignment="Center"
                Style="{StaticResource TransparentNoHoverButton}" />

                <Button Content="X"
                Click="btnRemoverAnexo_Click"
                Foreground="Red"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Style="{StaticResource TransparentNoHoverButton}" />
            </StackPanel>
        </DataTemplate>

        <Style TargetType="Button" x:Key="FilterButtonTheme">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Padding" Value="25,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">

                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="TicketButtonStyle">
            <Setter Property="Background" Value="Gray" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C94A46" />
                </Trigger>

                <DataTrigger Binding="{Binding Status}" Value="Aberto">
                    <Setter Property="Background" Value="#FF0275D8" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="Aceito">
                    <Setter Property="Background" Value="#FF6DB264" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="Finalizado">
                    <Setter Property="Background" Value="#FFE4D05C" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="Cancelado">
                    <Setter Property="Background" Value="#C94A46" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TicketItemTemplate">
            <Button Style="{StaticResource TicketButtonStyle}"
            Content="{Binding Id}"
            ContentStringFormat="TICKET#{0}"
            Click="TicketButton_Click" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C2C2C" CornerRadius="20" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Infiniti PRO" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,30,20,10" />
                    <TextBlock Text="SISTEMA DE SUPORTE" Foreground="Gray" FontSize="12" Margin="20,0,20,30" />

                    <Button x:Name="btnMenuTicket" Click="MenuButton_Click" Style="{StaticResource MenuButtonTheme}" Foreground="White">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Images/ticket_icon.png" Width="30" Height="30" Margin="10,0,10,0" />
                            <TextBlock Text="Ticket" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnMenuChat" Click="MenuButton_Click" Style="{StaticResource MenuButtonTheme}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Images/chat_icon.png" Width="30" Height="30" Margin="10,0,10,0" />
                            <TextBlock Text="Chat" VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Button x:Name="btnSair" Click="btnSair_Click" Style="{StaticResource MenuButtonTheme}" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Images/logout_icon2.png" Width="30" Height="30" Margin="10,0,10,0" />
                            <TextBlock Text="Sair" VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtNomeUsuario" Text="Nome do Usuário" Foreground="White" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,30,10" />
            <TextBlock Grid.Row="2" x:Name="txtClock" Text="DD/MM/YYYY HH:MM:SS" Foreground="Gray" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,30,15" />

            <Grid Margin="0,30,0,35" Grid.RowSpan="3">

                <Grid x:Name="TicketsView" Margin="30,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Ticket" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnAberto" Click="FilterButton_Click" Content="Aberto" Style="{StaticResource FilterButtonTheme}" />
                            <Button Grid.Column="1" x:Name="btnAceito" Click="FilterButton_Click" Content="Aceito" Style="{StaticResource FilterButtonTheme}" />
                            <Button Grid.Column="2" x:Name="btnFinalizado" Click="FilterButton_Click" Content="Finalizado" Style="{StaticResource FilterButtonTheme}" />
                            <Button Grid.Column="3" x:Name="btnCancelado" Click="FilterButton_Click" Content="Cancelado" Style="{StaticResource FilterButtonTheme}" />
                        </Grid>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                        <ItemsControl x:Name="ItemsControlTickets" ItemTemplate="{StaticResource TicketItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ChatView" Margin="30,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"  Text="Chat" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="10,0,10,10" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="txtConversasTitle" Text="Conversas" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="10,0,10,10" />
                            <Border Grid.Row="1" x:Name="ConversationPanel" Background="#3C3C3C" CornerRadius="15" Visibility="Hidden">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Hidden" Margin="10">
                                        <ItemsControl x:Name="MessagesList" ItemTemplate="{StaticResource MessageItemTemplate}" />
                                    </ScrollViewer>
                                    <Grid Grid.Row="1" Margin="20">
                                        <Border Background="#4A4A4A" CornerRadius="25" Height="50">
                                            <TextBox x:Name="txtChatMessage"
                 PreviewKeyDown="txtChatMessage_PreviewKeyDown"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Hidden"
                 FontSize="14"
                 Background="Transparent"
                 Foreground="White"
                 BorderThickness="0"
                 Padding="15,10"
                 VerticalContentAlignment="Center"
                 Margin="0,0,60,0" />
                                        </Border>

                                        <Button x:Name="btnSendMessage" Click="btnSendMessage_Click"
            Width="40" Height="40"
            HorizontalAlignment="Right"
            Margin="5"
            Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="buttonBorder"
                        Background="#898989"
                        CornerRadius="20">
                                                        <Image Source="/Images/enviar.png" Width="20" Height="20" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="buttonBorder" Property="Background" Value="#008a6e" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Contatos" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="10,0,10,10" />
                            <Border Grid.Row="1" Background="#3C3C3C" CornerRadius="15">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                                    <ItemsControl x:Name="ContactsList" ItemTemplate="{StaticResource ContactItemTemplate}" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="TicketDetailView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="30,40,30,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,20">
                            <TextBlock Text="Ticket gerado" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                            <Border x:Name="borderDetailTicketId" CornerRadius="15" Height="80" Background="#4A4A4A">
                                <TextBlock x:Name="txtDetailTicketId" Text="TICKET#1250" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,20">
                            <TextBlock Text="Usuário" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                            <Border Background="#4A4A4A" CornerRadius="15" Height="80">
                                <TextBlock x:Name="txtDetailUsuario" Text="Henrique" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <Grid Margin="30,0,30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,20">
                                <TextBlock Text="Descrição" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                                <Border Background="#4A4A4A" CornerRadius="15" Padding="20">
                                    <TextBlock x:Name="txtDetailDescricao" Foreground="White" FontSize="14" TextWrapping="Wrap" MinHeight="150" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,20">
                                <StackPanel x:Name="panelProfissional">
                                    <TextBlock Text="Profissional" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                                    <Border Background="#4A4A4A" CornerRadius="15" Height="80" Margin="0,0,0,20">
                                        <TextBlock x:Name="txtDetailProfissional" Text="Willian" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Setor" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                                <Border Background="#4A4A4A" CornerRadius="15" Height="80" Margin="0,0,0,20">
                                    <TextBlock x:Name="txtDetailSetor" Text="Marketing" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Anexo" Foreground="White" FontSize="16" Margin="0,0,0,10" />
                                <Border Background="#4A4A4A" CornerRadius="15" MinHeight="100" Padding="10">
                                    <ItemsControl x:Name="ItemsControlTicketAnexos" ItemTemplate="{StaticResource AnexoReadOnlyItemTemplate}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="30,20,30,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                            x:Name="btnSugestaoIA" 
                            Click="btnSugestaoIA_Click"
                            Content="Sugerir Solução (IA)" 
                            Style="{StaticResource FilterButtonTheme}" 
                            Background="#6A5ACD" 
                            Width="180" 
                            HorizontalAlignment="Left" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnAceitar" Click="btnAceitar_Click" Content="Aceitar" Style="{StaticResource FilterButtonTheme}" Background="#5CB85C" Width="100" />
                            <Button x:Name="btnFinalizar" Click="btnFinalizar_Click" Content="Finalizar" Style="{StaticResource FilterButtonTheme}" Background="#0275D8" Width="100" />
                            <Button x:Name="btnCancelar" Click="btnCancelar_Click" Content="Cancelar" Style="{StaticResource FilterButtonTheme}" Background="#D9534F" Width="110" />
                            <Button x:Name="btnInformacoes" Click="btnInformacoes_Click" Content="Informações" Style="{StaticResource FilterButtonTheme}" Background="#f0ad4e" Width="126" />
                            <Button x:Name="btnVoltar" Click="btnVoltar_Click" Content="Voltar" Style="{StaticResource FilterButtonTheme}" Width="100" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="FinalizarTicketView" Visibility="Collapsed" Margin="0,50,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Descrição" Foreground="White" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        <Border Background="#4A4A4A" CornerRadius="15" Padding="10">
                            <TextBox x:Name="txtSolucao" Width="600" MinHeight="200" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <TextBlock Text="Anexo" Foreground="White" FontSize="16" Margin="0,20,0,10" HorizontalAlignment="Left" />
                        <Border Background="#4A4A4A" CornerRadius="15" MinHeight="120" Padding="10">
                            <Grid>
                                <ItemsControl x:Name="ItemsControlAnexos" Margin="0,0,0,30">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,5,0,5">
                                                <Image Source="{Binding }" Width="20" Height="20" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" />
                                                <Button Content="X" Click="btnRemoverAnexo_Click" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Style="{StaticResource TransparentNoHoverButton}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="btnAddAnexo" Click="btnAddAnexo_Click"
                                    Content="+"
                                    Foreground="Gray" FontSize="48" FontWeight="Light"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Style="{StaticResource TransparentNoHoverButton}" />
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="btnConfirmarFinalizacao" Click="btnConfirmarFinalizacao_Click" Content="Finalizar" Style="{StaticResource FilterButtonTheme}" Background="#5CB85C" Width="100" />
                            <Button x:Name="btnVoltarDaFinalizacao" Click="btnVoltarDaFinalizacao_Click" Content="Voltar" Style="{StaticResource FilterButtonTheme}" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SolucaoTicketView" Visibility="Collapsed" Margin="0,50,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Descrição da solução" Foreground="White" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Left" />
                        <Border Background="#4A4A4A" CornerRadius="15" Padding="20">
                            <TextBlock x:Name="txtSolucaoDetalhes" Width="600" MinHeight="200" Foreground="White" FontSize="14" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="Anexos da solução" Foreground="White" FontSize="16" Margin="0,20,0,10" HorizontalAlignment="Left" />
                        <Border Background="#4A4A4A" CornerRadius="15" MinHeight="120" Padding="10">
                            <ItemsControl x:Name="ItemsControlSolucaoAnexos" ItemTemplate="{StaticResource AnexoReadOnlyItemTemplate}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="btnVoltarDaSolucao" Click="btnVoltarDaSolucao_Click" Content="Voltar" Style="{StaticResource FilterButtonTheme}" Width="100" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ConfirmCancelView" Visibility="Collapsed" Panel.ZIndex="2">
                    <Border Background="#AA000000" />
                    <Border Background="#333333" CornerRadius="10" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                        <StackPanel>
                            <TextBlock Text="Confirmar Cancelamento" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />
                            <TextBlock Text="Tem certeza que deseja cancelar este ticket? Esta ação não pode ser desfeita." Foreground="LightGray" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,30" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnConfirmCancel" Click="btnConfirmCancel_Click" Content="Sim, Cancelar" Style="{StaticResource FilterButtonTheme}" Background="#D9534F" Width="135" Margin="0,0,10,0" />
                                <Button x:Name="btnAbortCancel" Click="btnAbortCancel_Click" Content="Não" Style="{StaticResource FilterButtonTheme}" Width="80" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="NotificationToast" CornerRadius="10" Background="#333333" BorderBrush="#5CB85C" BorderThickness="2" Padding="20,15" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="3">
                    <TextBlock x:Name="NotificationText" Text="Ação concluída com sucesso!" Foreground="White" FontSize="16" FontWeight="Bold" />
                </Border>
            </Grid>
            <Grid x:Name="IaSuggestionView" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="5">
                <Border Background="#333333" CornerRadius="10" Padding="30" 
    HorizontalAlignment="Center" VerticalAlignment="Center"
    MinWidth="600"  MaxWidth="900"  MinHeight="400" MaxHeight="650">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sugestão da Inteligência Artificial" 
               Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,20">
                            <TextBlock x:Name="IaSuggestionText" Text="A resposta da IA aparecerá aqui..."
                   Foreground="LightGray" FontSize="14" TextWrapping="Wrap"/>
                        </ScrollViewer>

                        <Button Grid.Row="2" x:Name="btnIaOk" Click="btnIaOk_Click" 
            Content="OK" Style="{StaticResource FilterButtonTheme}" 
            HorizontalAlignment="Right" Width="100" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        

    </Grid>
</Window>